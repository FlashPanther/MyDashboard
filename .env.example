# --- Google OAuth (Calendar, Tasks, Gmail) -------------------------------
# Console Google Cloud > API et services > Identifiants > ID client OAuth 2.0
# Type "Application Web", URI de redirection autorisee :
#   http://localhost:3737/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3737/api/auth/google/callback

# --- Trajet voiture ------------------------------------------------------
# Choix du fournisseur : "osrm" (gratuit, sans cle, SANS trafic),
# "tomtom" (gratuit 2500 req/j, AVEC trafic) ou "google" (Routes API, AVEC trafic)
CAR_PROVIDER=osrm
TOMTOM_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- iRail ---------------------------------------------------------------
# iRail demande un User-Agent identifiable (nom d'app + contact)
IRAIL_USER_AGENT=myDashboard/1.0 (devos.thom@gmail.com)

# --- En ligne (Coolify) --------------------------------------------------
# Vides en local : le tableau reste ouvert, comme avant. En ligne, les deux
# sont indispensables (voir « Déployer sur Coolify » dans le README).
# Mot de passe de la page de connexion (long : il protege mails et messages).
DASHBOARD_PASSWORD=
# Jeton partage avec l'extension (a recopier dans ses options). Par exemple :
#   openssl rand -base64 32
EXTENSION_TOKEN=
